{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "test:dependency-compat": "node --test scripts/src/dependency-compat.test.cjs",
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@scalar/json-magic": "0.12.8",
      "body-parser": "2.4.0",
      "brace-expansion": "5.0.12",
      "browserslist": "4.28.8",
      "esbuild": "0.25.8",
      "fast-copy": "4.1.0",
      "fast-uri": "3.1.9",
      "js-yaml": "4.3.2",
      "linkify-it": "5.0.2",
      "markdown-it": "14.3.3",
      "minimatch": "11.0.4",
      "nanoid": "3.3.18",
      "postcss": "8.5.26",
      "postcss-selector-parser": "6.1.5",
      "proxy-addr": "2.0.8",
      "qs": "6.16.1",
      "source-map-js": "1.2.2",
      "uuid": "11.1.1",
      "vite": "7.3.7"
    },
    "patchedDependencies": {
      "glob@7.2.3": "patches/glob@7.2.3.patch"
    }
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
